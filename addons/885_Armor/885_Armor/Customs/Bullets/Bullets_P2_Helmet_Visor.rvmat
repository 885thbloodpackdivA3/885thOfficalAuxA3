/*
	Bullets P2 Helmet - glossy visor
	Shine comes from: high specular + tight specularPower, a full-gloss SMDI,
	a strong fresnel and the world environment map (reflections).
	Uses Bullets_Custom_revised_P2 _NOHQ / _AS / _SMDI maps (paired with the _CO).
	No emissive, so it shines without glowing in the dark.

	Tuning:
	  - Less mirror-like  -> lower fresnel() values in Stage6 (e.g. 1.5,0.5)
	  - Softer highlight  -> lower specularPower (e.g. 200)
	  - Tint highlight    -> change specular[] RGB (currently a slight red tint)
*/
ambient[] = { 1, 1, 1, 1 };
diffuse[] = { 1, 1, 1, 1 };
forcedDiffuse[] = { 0, 0, 0, 0 };
emmisive[] = { 0, 0, 0, 1 };
specular[] = { 1, 0.85, 0.85, 1 };
specularPower = 600;
PixelShaderID = "Super";
VertexShaderID = "Super";
class Stage1 {
	texture = "885_Armor\885_Armor\Customs\Bullets\Bullets_Custom_revised_P2_NOHQ.paa";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage2 {
	texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,dt)";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage3 {
	texture = "#(argb,8,8,3)color(0,0,0,0,mc)";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage4 {
	texture = "885_Armor\885_Armor\Customs\Bullets\Bullets_Custom_revised_P2_AS.paa";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage5 {
	// SMDI: G = specular strength, B = glossiness (brighter = shinier)
	// Fallback if the visor looks dull: "#(argb,8,8,3)color(1,1,1,1,smdi)"
	texture = "885_Armor\885_Armor\Customs\Bullets\Bullets_Custom_revised_P2_SMDI.paa";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage6 {
	texture = "#(ai,64,64,1)fresnel(2.5,1.0)";
	uvSource = "none";
};
class Stage7 {
	texture = "a3\data_f\env_land_ca.paa";
	useWorldEnvMap = "true";
	uvSource = "none";
};
class StageTI {
	texture = "a3\data_f\default_vehicle_ti_ca.paa";
};
